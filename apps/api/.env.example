# Copie para apps/api/.env e PREENCHA os dois secrets antes de subir a API.
#
# Porta 5433: e a que o docker-compose.yml publica (${POSTGRES_PORT:-5433}:5432).
DATABASE_URL="postgresql://academia:academia@localhost:5433/academia_db"

# Os dois secrets abaixo sao OBRIGATORIOS e precisam ter no minimo 32 caracteres:
# assertJwtSecret() (apps/api/src/auth/jwt.config.ts) aborta o boot se forem menores.
# Deixados VAZIOS de proposito - um template nunca deve trazer valor com cara de
# credencial. Gere os seus:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3000
