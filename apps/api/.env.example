DATABASE_URL="postgresql://academia:academia@localhost:5433/academia_db"
# Os dois secrets abaixo precisam ter NO MINIMO 32 caracteres: assertJwtSecret()
# (apps/api/src/auth/jwt.config.ts) aborta o boot se forem menores. Gere os seus com
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="troque-me-access-secret-com-32-chars-ou-mais"
JWT_REFRESH_SECRET="troque-me-refresh-secret-com-32-chars-ou-mais"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3000
