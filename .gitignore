**/node_modules
**/.expo
**/.expo-shared
**/coverage
**/dist
# Added by code-review-graph
.code-review-graph/

# Orca pipeline (orca-config): specs/planos/estado são locais; só LEARNINGS.md é versionado
docs/pipeline/*
!docs/pipeline/LEARNINGS.md
.orca/

# this repo uses npm workspaces — a single root package-lock.json is the source of truth.
# nested lockfiles (per-workspace) and yarn.lock are forbidden to avoid drift.
apps/*/package-lock.json
packages/*/package-lock.json
yarn.lock
apps/*/yarn.lock
packages/*/yarn.lock

# secrets
apps/api/.env
.env
!.env.example

# Claude worktrees + local IDE state
.claude/worktrees/
.claude/settings.json
.claude/settings.local.json

# accidental Windows artifacts
NUL
apps/api/NUL
apps/mobile/NUL
Tomorrow

# personal/binary files not part of the project
GIFS/

# backups de ambiente (contem segredos)
*.env.bak
